# Production credentials only. Copy to .env.local and fill in.

# Stytch public token (LIVE) — authenticates the user in the browser. The
# resulting session JWT is sent as `Authorization: Bearer <jwt>` on every call.
# Find it at https://stytch.com/dashboard?project_id=<your-project-id>
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-live-...

# Crossmint client-side PRODUCTION API key. Calls run in the browser, so this
# key is PUBLIC (inlined via the NEXT_PUBLIC_ prefix). That is expected for a
# ck_ key — restrict it with the allowed-origins setting on the key in the
# Crossmint console, and give it the scopes:
# agentic-checkouts.create | read | update | cancel.
# To use the Packs tab, also add the pack scopes:
# agentic-checkouts.packs.create | read | update | delete.
NEXT_PUBLIC_CROSSMINT_API_KEY=ck_production_...

# Production host for the Agentic Checkouts API. The app calls
# ${NEXT_PUBLIC_CROSSMINT_BASE_URL}/api/unstable/agentic-checkouts under the hood.
NEXT_PUBLIC_CROSSMINT_BASE_URL=https://www.crossmint.com
